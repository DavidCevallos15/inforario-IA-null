# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# La clave "publishable"/anon es pública por diseño; la seguridad depende de las políticas RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# ID de cliente OAuth de Google (público) para vincular Google Calendar
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
